{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_APP_MODE": "production",
        "EXPO_PUBLIC_SUBSCRIPTION_PURCHASE_ENTRY_ENABLED": "0",
        "EXPO_PUBLIC_QUOTA_UPSELL_ENABLED": "0"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": false,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_MODE": "production",
        "EXPO_PUBLIC_SUBSCRIPTION_PURCHASE_ENTRY_ENABLED": "0",
        "EXPO_PUBLIC_QUOTA_UPSELL_ENABLED": "0"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "internal-grin": {
      "autoIncrement": false,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_MODE": "production",
        "EXPO_PUBLIC_SUBSCRIPTION_PURCHASE_ENTRY_ENABLED": "1",
        "EXPO_PUBLIC_QUOTA_UPSELL_ENABLED": "0",
        "EXPO_PUBLIC_GOODS_EVIDENCE_ENABLED": "1",
        "EXPO_PUBLIC_GOODS_EVIDENCE_STORE_RUNTIME_ADMIT": "1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "internal-grin-apk": {
      "autoIncrement": false,
      "distribution": "internal",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_MODE": "production",
        "EXPO_PUBLIC_SUBSCRIPTION_PURCHASE_ENTRY_ENABLED": "0",
        "EXPO_PUBLIC_QUOTA_UPSELL_ENABLED": "0",
        "EXPO_PUBLIC_GOODS_EVIDENCE_ENABLED": "1",
        "EXPO_PUBLIC_GOODS_EVIDENCE_STORE_RUNTIME_ADMIT": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "internal-auth-validation": {
      "autoIncrement": false,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_MODE": "production",
        "EXPO_PUBLIC_SUBSCRIPTION_PURCHASE_ENTRY_ENABLED": "0",
        "EXPO_PUBLIC_QUOTA_UPSELL_ENABLED": "0",
        "EXPO_PUBLIC_GOODS_EVIDENCE_ENABLED": "0",
        "EXPO_PUBLIC_GOODS_EVIDENCE_STORE_RUNTIME_ADMIT": "0"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_MODE": "production"
      }
    },
    "acceptance-android": {
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_APP_MODE": "production",
        "EXPO_PUBLIC_RESTORE_ADMISSION_REFRESH": "true",
        "EXPO_PUBLIC_SUBSCRIPTION_PURCHASE_ENTRY_ENABLED": "0",
        "EXPO_PUBLIC_QUOTA_UPSELL_ENABLED": "0"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "development-production-otp": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_MODE": "production"
      }
    }
  },
  "submit": {
    "production": {},
    "internal-grin": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "internal-auth-validation": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
