{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/goodsEvidence/*": ["../../src/goodsEvidence/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "../../src/goodsEvidence/evidence.ts",
    "../../src/goodsEvidence/ports.ts",
    "../../src/goodsEvidence/time.ts",
    "../../src/goodsEvidence/constants.ts"
  ],
  "exclude": ["./**/*.test.ts", "./harness.ts"]
}
