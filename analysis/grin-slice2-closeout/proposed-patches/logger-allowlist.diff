--- src/services/telemetry/crashReporter.ts
recordError(error, context):
  if (!_enabled) return;  // consent unchanged
  const safe = new Error(classifyError(error).class);
  safe.name = error.name === "Error" ? "AppError" : String(error.name).slice(0, 64);
  // Do NOT assign safe.cause = error, do NOT pass error.stack unmodified
  // if it can contain URLs/tokens. Use a truncated frame list without
  // query strings, or omit stack in v1 of this patch.
  client.log(String(context || "app").slice(0, 64));
  client.recordError(safe);

