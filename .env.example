# =========================================================
# Vyaamikk Diary — Environment Configuration
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to source control.
# =========================================================

# ---------------------------------------------------------
# Active backend (resolved at runtime — see src/config/runtimeEnvironment.ts)
#
#   Expo Go (npm run start:expo-go)
#     → local-mock always (mock OTP 123456 + AsyncStorage).
#     Bundled APP_MODE is ignored; shared-dev is never used in Expo Go.
#
#   Production dev client (EAS profile development-production-otp)
#     → firebase-production only.
#     Metro MUST override local .env: npm run start:prod-dev-client
#     (sets EXPO_PUBLIC_APP_MODE=production for the Metro process).
#     Shell env wins over .env — verified by npm run test:env-shell-precedence.
#
#   EAS preview / store production
#     → firebase-production (APP_MODE=production baked at EAS build).
#
#   Web dev (optional)
#     APP_MODE=development → local-mock (default)
#     APP_MODE=development + DEV_BACKEND=shared-dev → firebase-shared-dev
#       (separate dev Firebase project with firestore.rules.dev only)
#
#   APP_MODE=production + Firebase config → firebase-production
#     Real Firebase Auth phone OTP + Firestore. Requires native dev build
#     (EAS profile development-production-otp) — not Expo Go.
# ---------------------------------------------------------
EXPO_PUBLIC_APP_MODE=development
# EXPO_PUBLIC_DEV_BACKEND=shared-dev

# Auth: Indigo Auth v2 is the only sign-in UI (/(auth)/v2).
# EXPO_PUBLIC_AUTH_WRAPPER_V2 is deprecated — ignored if set.

# ---- Firebase ----------------------------------------------
# Required for production dev client, preview, store, and optional shared-dev.
# Get these from: Firebase Console → Project Settings → Your apps → Web SDK config.
# (For dev: enable Firestore in "test mode" and deploy firestore.rules.dev.
#  For prod: deploy firestore.rules.)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ---- Branding (safe to commit defaults) --------------------
EXPO_PUBLIC_BRAND_OWNER="SPECIAL SOFTWARES"
EXPO_PUBLIC_PRIVACY_URL=https://vyaamikk.specialsoftwares.in/privacy
EXPO_PUBLIC_TERMS_URL=https://vyaamikk.specialsoftwares.in/terms
EXPO_PUBLIC_LEGAL_URL=https://vyaamikk.specialsoftwares.in/legal
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://vyaamikk.specialsoftwares.in/delete-account
EXPO_PUBLIC_SUPPORT_EMAIL=support@specialsoftwares.in
EXPO_PUBLIC_APP_INSTALL_URL=https://vyaamikk.specialsoftwares.in/download
# Cloud Functions region (must match functions/src deploy region)
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south1
# Optional: local emulator — e.g. 127.0.0.1:5001
# EXPO_PUBLIC_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001

# ---- Dev-only locale generation (NEVER prefix with EXPO_PUBLIC_) ----
# Used by: npm run i18n:translate-draft
# GOOGLE_TRANSLATE_API_KEY=

# ---- Server / CI only (NEVER prefix with EXPO_PUBLIC_) ----
# These are NOT bundled into the mobile app. Use in backend scripts or EAS secrets.
# DATABASE_URL=
# JWT_SECRET=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
# SMS_PROVIDER_API_KEY=
# SENTRY_AUTH_TOKEN=
