# =========================================================
# Vyaamikk Diary — Environment Configuration
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to source control.
# =========================================================

# ---------------------------------------------------------
# Active backend (auto-detected from APP_MODE + Firebase config):
#
#   APP_MODE=development  +  no Firebase config   →  local-mock
#     Mock OTP (123456) + AsyncStorage. Single-device only —
#     profile & diary changes will NOT sync between iOS and Android.
#     Good for quick UI work and offline testing.
#
#   APP_MODE=development  +  Firebase config set  →  shared-dev
#     Mock OTP (123456) + REAL Firestore. Profile & diary sync across
#     devices that share the same Firebase project. THIS is the mode
#     to use when testing the same mobile number on iOS and Android.
#
#   APP_MODE=production   +  Firebase config set  →  firebase-production
#     Real Firebase Auth phone OTP + Firestore. Requires you to wire
#     up a native phone verifier (see HANDOVER.md §14).
# ---------------------------------------------------------
EXPO_PUBLIC_APP_MODE=development

# Auth: Indigo Auth v2 is the only sign-in UI (/(auth)/v2).
# EXPO_PUBLIC_AUTH_WRAPPER_V2 is deprecated — ignored if set.

# ---- Firebase ----------------------------------------------
# Required for shared-dev and production. Get these from:
# Firebase Console → Project Settings → Your apps → Web SDK config.
# (For dev: enable Firestore in "test mode" and deploy
# firestore.rules.dev. For prod: deploy firestore.rules.)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ---- Branding (safe to commit defaults) --------------------
EXPO_PUBLIC_BRAND_OWNER="SPECIAL SOFTWARES"
EXPO_PUBLIC_PRIVACY_URL=https://vyaamikk.specialsoftwares.in/privacy
EXPO_PUBLIC_TERMS_URL=https://vyaamikk.specialsoftwares.in/terms
EXPO_PUBLIC_LEGAL_URL=https://vyaamikk.specialsoftwares.in/legal
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://vyaamikk.specialsoftwares.in/delete-account
EXPO_PUBLIC_SUPPORT_EMAIL=support@specialsoftwares.in
EXPO_PUBLIC_APP_INSTALL_URL=https://vyaamikk.specialsoftwares.in/download
# Cloud Functions region (must match functions/src deploy region)
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south1
# Optional: local emulator — e.g. 127.0.0.1:5001
# EXPO_PUBLIC_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001

# ---- Dev-only locale generation (NEVER prefix with EXPO_PUBLIC_) ----
# Used by: npm run i18n:translate-draft
# GOOGLE_TRANSLATE_API_KEY=

# ---- Server / CI only (NEVER prefix with EXPO_PUBLIC_) ----
# These are NOT bundled into the mobile app. Use in backend scripts or EAS secrets.
# DATABASE_URL=
# JWT_SECRET=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
# SMS_PROVIDER_API_KEY=
# SENTRY_AUTH_TOKEN=
