# =========================================================
# Vyaamikk Diary — Environment Configuration
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to source control.
# =========================================================

# ---------------------------------------------------------
# Active backend (resolved at runtime — see src/config/runtimeEnvironment.ts)
#
#   CRITICAL (Expo SDK virtual env):
#   In the Metro client bundle, `expo/virtual/env` merges `.env*` FILE values
#   ON TOP OF process.env. A shell-only `EXPO_PUBLIC_APP_MODE=production` does
#   NOT override `EXPO_PUBLIC_APP_MODE=development` from `.env`.
#   For native development-client Metro, set APP_MODE=production in `.env`
#   (or `.env.local`). `npm run start:prod-dev-client` still sets the shell
#   var for tooling, but the file value is authoritative for the JS bundle.
#
#   Expo Go (npm run start:expo-go)
#     → local-mock always (AsyncStorage).
#     Start with: npm run start:expo-go
#     (sets EXPO_PUBLIC_LOCAL_MOCK_MOBILE_OTP=1 and EXPO_PUBLIC_LOCAL_MOCK_EMAIL_OTP=1;
#      deterministic OTP is 000000 — never shown in the UI).
#     Effective app mode is forced to development at runtime; bundled APP_MODE
#     is ignored for Expo Go isolation.
#
#   Native development client (EAS profiles `development` and
#   `development-production-otp` — both bake EXPO_PUBLIC_APP_MODE=production)
#     → firebase-production only (never local-mock).
#     Daily owner workflow (physical phone): npm run start:prod-dev-client
#     AND local `.env` must have EXPO_PUBLIC_APP_MODE=production.
#     Do NOT leave APP_MODE=development in `.env` while using a development client.
#
#   Firebase Console fictional Phone Auth numbers (emulator / isolated only):
#     Configure numbers + OTP in Firebase Console → Authentication → Phone
#     (Phone numbers for testing). Do NOT hardcode them in source.
#     Then set EXPO_PUBLIC_FIREBASE_PHONE_AUTH_TEST_MODE=1 in `.env` and restart
#     Metro with npm run start:prod-dev-client:firebase-test-phones.
#     This enables appVerificationDisabledForTesting ONLY in development-client
#     Metro. Never set this for physical real-SMS sessions, preview, or store.
#     Distinct from LOCAL_MOCK_* (Expo Go mock OTP — separate path).
# EXPO_PUBLIC_FIREBASE_PHONE_AUTH_TEST_MODE=1
#
#   EAS preview (internal standalone APK, no Metro) / store production (AAB)
#     → firebase-production when Firebase public config is present, else fail closed.
#     Never local-mock / shared-dev. Mock OTP 000000 is structurally blocked.
#
#   Web dev (optional)
#     APP_MODE=development → local-mock (default)
#     APP_MODE=development + DEV_BACKEND=shared-dev → firebase-shared-dev
#       (separate dev Firebase project with firestore.rules.dev only)
#
#   APP_MODE=production + Firebase config → firebase-production
#     Real Firebase Auth phone OTP + Firestore. Requires native dev build
#     (EAS profile development-production-otp) — not Expo Go.
# ---------------------------------------------------------
EXPO_PUBLIC_APP_MODE=production
# EXPO_PUBLIC_DEV_BACKEND=shared-dev

# Auth: Indigo Auth v2 is the only sign-in UI (/(auth)/v2).
# EXPO_PUBLIC_AUTH_WRAPPER_V2 is deprecated — ignored if set.

# ---- Firebase ----------------------------------------------
# Required for production dev client, preview, store, and optional shared-dev.
# Get these from: Firebase Console → Project Settings → Your apps → Web SDK config.
# (For dev: enable Firestore in "test mode" and deploy firestore.rules.dev.
#  For prod: deploy firestore.rules.)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ---- Public website / legal / support --------------------------------------
# Authoritative production origin (published):
#   https://vyaamikk.specialsoftwares.com
# Website routes: /, /privacy, /terms, /support, /contact,
# /delete-account, /download, /faq. Never point end-users at /auth.
EXPO_PUBLIC_BRAND_OWNER="SPECIAL SOFTWARES"
EXPO_PUBLIC_WEBSITE_URL=https://vyaamikk.specialsoftwares.com
EXPO_PUBLIC_PRIVACY_URL=https://vyaamikk.specialsoftwares.com/privacy
EXPO_PUBLIC_TERMS_URL=https://vyaamikk.specialsoftwares.com/terms
# Legal hub = website home (site has no combined /legal page)
EXPO_PUBLIC_LEGAL_URL=https://vyaamikk.specialsoftwares.com/
EXPO_PUBLIC_SUPPORT_URL=https://vyaamikk.specialsoftwares.com/support
EXPO_PUBLIC_CONTACT_URL=https://vyaamikk.specialsoftwares.com/contact
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://vyaamikk.specialsoftwares.com/delete-account
EXPO_PUBLIC_SUPPORT_EMAIL=support.vyd@specialsoftwares.com
# Pre-launch download / launch-status page — not a live store listing
EXPO_PUBLIC_APP_INSTALL_URL=https://vyaamikk.specialsoftwares.com/download
# Leave empty until real store listings exist (do not invent URLs)
# EXPO_PUBLIC_APP_STORE_URL=
# EXPO_PUBLIC_PLAY_STORE_URL=
# Cloud Functions region (must match functions/src deploy region)
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south1
# Optional: local emulator — e.g. 127.0.0.1:5001
# EXPO_PUBLIC_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001

# ---- Dev-only locale generation (NEVER prefix with EXPO_PUBLIC_) ----
# Used by: npm run i18n:translate-draft
# GOOGLE_TRANSLATE_API_KEY=

# ---- Server / CI only (NEVER prefix with EXPO_PUBLIC_) ----
# These are NOT bundled into the mobile app. Use in backend scripts or EAS secrets.
# DATABASE_URL=
# JWT_SECRET=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
# SMS_PROVIDER_API_KEY=
# SENTRY_AUTH_TOKEN=
