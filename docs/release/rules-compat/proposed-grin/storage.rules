rules_version = '2';

// Additive GRIN merge against docs/release/rules-compat/proposed/storage.rules
// (live-compat letterhead/attachments/pdfs). Not live. Do not firebase deploy
// from this file.

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc(userId) {
      return firestore.get(/databases/(default)/documents/users/$(userId)).data;
    }

    function ownerUserActive(userId) {
      return isOwner(userId)
        && userDoc(userId).get('status', 'active') == 'active';
    }

    function admissionPath(userId) {
      return /databases/(default)/documents/users/$(userId)/goodsEvidenceAdmission/runtime;
    }

    function admissionAllowsNewCommands(userId) {
      return firestore.exists(admissionPath(userId))
        && firestore.get(admissionPath(userId)).data.schemaVersion == 1
        && firestore.get(admissionPath(userId)).data.newCommands == 'allow';
    }

    function objectKeyDoc(userId, objectKey) {
      return /databases/(default)/documents/users/$(userId)/grinEvidenceObjectKeys/$(objectKey);
    }

    function objectKeyExists(userId, objectKey) {
      return firestore.exists(objectKeyDoc(userId, objectKey));
    }

    function objectKeyState(userId, objectKey) {
      return firestore.get(objectKeyDoc(userId, objectKey)).data.state;
    }

    function objectKeyLedgerId(userId, objectKey) {
      return firestore.get(objectKeyDoc(userId, objectKey)).data.ledgerId;
    }

    function ledgerDoc(userId, ledgerId) {
      return firestore.get(/databases/(default)/documents/users/$(userId)/goodsEvidenceLedgers/$(ledgerId));
    }

    function boundLedgerActive(userId, objectKey) {
      return objectKeyExists(userId, objectKey)
        && ledgerDoc(userId, objectKeyLedgerId(userId, objectKey)).data.ownerUid == userId
        && ledgerDoc(userId, objectKeyLedgerId(userId, objectKey)).data.status == 'active';
    }

    function isFlightState(userId, objectKey) {
      return objectKeyExists(userId, objectKey)
        && (
          objectKeyState(userId, objectKey) == 'reserved'
          || objectKeyState(userId, objectKey) == 'uploading'
        );
    }

    function isRetainedOriginalState(userId, objectKey) {
      return objectKeyExists(userId, objectKey)
        && (
          objectKeyState(userId, objectKey) == 'uploaded_unverified'
          || objectKeyState(userId, objectKey) == 'verified'
          || objectKeyState(userId, objectKey) == 'linked'
        );
    }

    function isVerifiedOrLinked(userId, objectKey) {
      return objectKeyExists(userId, objectKey)
        && (
          objectKeyState(userId, objectKey) == 'verified'
          || objectKeyState(userId, objectKey) == 'linked'
        );
    }

    function hasFlightReservation(userId, objectKey) {
      return isFlightState(userId, objectKey);
    }

    function canUploadOriginal(userId, objectKey) {
      return ownerUserActive(userId)
        && admissionAllowsNewCommands(userId)
        && hasFlightReservation(userId, objectKey)
        && boundLedgerActive(userId, objectKey);
    }

    function canReadOriginal(userId, objectKey) {
      return ownerUserActive(userId)
        && boundLedgerActive(userId, objectKey)
        && (
          (isFlightState(userId, objectKey) && admissionAllowsNewCommands(userId))
          || isRetainedOriginalState(userId, objectKey)
        );
    }

    function derivativeReservationDoc(userId, derivativeKey) {
      return /databases/(default)/documents/users/$(userId)/grinEvidenceDerivativeKeys/$(derivativeKey);
    }

    function hasDerivativeFlightReservation(userId, objectKey, derivativeKey) {
      return firestore.exists(derivativeReservationDoc(userId, derivativeKey))
        && firestore.get(derivativeReservationDoc(userId, derivativeKey)).data.parentObjectKey == objectKey
        && (
          firestore.get(derivativeReservationDoc(userId, derivativeKey)).data.state == 'reserved'
          || firestore.get(derivativeReservationDoc(userId, derivativeKey)).data.state == 'uploading'
        )
        && (
          firestore.get(derivativeReservationDoc(userId, derivativeKey)).data.kind == 'thumbnail'
          || firestore.get(derivativeReservationDoc(userId, derivativeKey)).data.kind == 'preview'
          || firestore.get(derivativeReservationDoc(userId, derivativeKey)).data.kind == 'ocr'
        );
    }

    function canCreateDerivative(userId, objectKey, derivativeKey) {
      return ownerUserActive(userId)
        && admissionAllowsNewCommands(userId)
        && boundLedgerActive(userId, objectKey)
        && isVerifiedOrLinked(userId, objectKey)
        && hasDerivativeFlightReservation(userId, objectKey, derivativeKey);
    }

    function canReadDerivative(userId, objectKey) {
      return ownerUserActive(userId)
        && boundLedgerActive(userId, objectKey)
        && isVerifiedOrLinked(userId, objectKey);
    }

    function allowedGrinOriginalMime() {
      return request.resource.contentType == 'application/pdf'
        || request.resource.contentType == 'image/jpeg'
        || request.resource.contentType == 'image/png'
        || request.resource.contentType == 'image/webp';
    }

    function withinOriginalSize() {
      return request.resource.size < 15 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
            ? request.resource.size < 15 * 1024 * 1024
            : request.resource.size < 10 * 1024 * 1024
        );
    }

    function allowedDerivativeMime() {
      return request.resource.contentType == 'image/jpeg'
        || request.resource.contentType == 'image/png'
        || request.resource.contentType == 'image/webp';
    }

    function noClientVerificationMetadata() {
      return !('rawSha256' in request.resource.metadata)
        && !('verified' in request.resource.metadata)
        && !('state' in request.resource.metadata)
        && !('generationBind' in request.resource.metadata)
        && !('verifiedAtUtc' in request.resource.metadata);
    }

    match /users/{userId}/letterhead/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /users/{userId}/attachments/{recordId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /users/{userId}/pdfs/{recordId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }

    match /users/{userId}/grinEvidence/{objectKey}/original {
      allow read: if canReadOriginal(userId, objectKey);
      allow create: if canUploadOriginal(userId, objectKey)
                    && resource == null
                    && allowedGrinOriginalMime()
                    && withinOriginalSize()
                    && noClientVerificationMetadata();
      allow update, delete: if false;
    }

    match /users/{userId}/grinEvidence/{objectKey}/derivatives/{derivativeKey} {
      allow read: if canReadDerivative(userId, objectKey);
      allow create: if canCreateDerivative(userId, objectKey, derivativeKey)
                    && resource == null
                    && request.resource.size < 2 * 1024 * 1024
                    && allowedDerivativeMime()
                    && noClientVerificationMetadata();
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
