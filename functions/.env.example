# Vyaamikk Diary — Cloud Functions / billing configuration (VYD-40)
#
# Placeholders only. Never put real secrets or owner GST identity in this file.
# Production GST issuance remains fail-closed until the owner authorizes
# certificate-confirmed seller identity, CA-approved SAC/rate, reverse-charge
# mode, price-includes-GST basis, and Cloud Run.

# ---- Non-secrets (placeholders) ------------------------------------------
COMPANY_GSTIN=
COMPANY_LEGAL_NAME=
COMPANY_TRADE_NAME=
COMPANY_GST_REGISTERED_ADDRESS=
COMPANY_GST_STATE_CODE=
SERVICE_SAC_CODE=
SERVICE_SAC_DESCRIPTION=
GST_RATE_BPS=
PRICE_INCLUDES_GST=
REVERSE_CHARGE_MODE=
APPLE_TAX_RESPONSIBILITY_MODE=
GOOGLE_TAX_RESPONSIBILITY_MODE=
DIRECT_WEB_TAX_RESPONSIBILITY_MODE=
BILLING_EMAIL_FROM_ADDRESS=
ADMIN_EMAIL=
ADMIN_IDENTITY_PROVISIONED=false
INVOICE_RENDERER_URL=
GSTR_FILING_FREQUENCY=monthly

# Reviewed ECO / Table-14 classification. Leave blank until CA/legal approval.
# Allowed values after review:
#   requires_tax_review | not_applicable | section52_table14a | section9_5_table14b
# Generic "classified" is not a legal category and fails closed to requires_tax_review.
GOOGLE_ECO_REPORTING_CATEGORY=
GOOGLE_OPERATOR_IDENTIFIER=
GOOGLE_OPERATOR_GSTIN=
APPLE_ECO_REPORTING_CATEGORY=
APPLE_OPERATOR_IDENTIFIER=
APPLE_OPERATOR_GSTIN=
DIRECT_WEB_ECO_REPORTING_CATEGORY=
DIRECT_WEB_OPERATOR_IDENTIFIER=
DIRECT_WEB_OPERATOR_GSTIN=

# Invoice-issue aging / Section-34 outer limit are modelled in code.
# Auto-enforcing pending-GSTIN holds against invoiceIssueDueAt is a
# production-enablement gate, not a VYD-40 merge blocker.

# ---- Secret NAMES only (values live in Secret Manager; never here) -------
# EMAIL_PROVIDER_API_KEY
# BILLING_DIAG_UID_SECRET
# TRIAL_IDENTITY_SECRET
# APPSTORE_PRIVATE_KEY
#
# Do not add:
#   GOOGLE_PLAY_SERVICE_ACCOUNT_KEY
#   APPLE_SHARED_SECRET
#   RESEND_API_KEY   (reuse EMAIL_PROVIDER_API_KEY)

# ---- Google Play billing (VYD-32) — placeholders only; production OFF ----
